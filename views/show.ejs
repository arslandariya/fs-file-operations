<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Read More</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-900 text-white">
    <div class="w-full min-h-screen p-8 md:p-14">
        <a href="/"
            class="inline-block text-blue-400 hover:text-blue-300 transition-colors mb-10 text-lg font-medium">←Go
            BackHome</a>
        <h1
            class="text-4xl md:text-5xl font-bold tracking-tight mb-6 bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">
            <%= filename %>
        </h1>
        <div class="bg-zinc-800/60 backdrop-blur-xl rounded-2xl p-6 md:p-10 shadow-2xl border border-zinc-700/50">
            <p class="text-lg md:text-xl leading-relaxed whitespace-pre-wrap">
                <%= filedata %>
            </p>
        </div>

    </div>
</body>

</html>