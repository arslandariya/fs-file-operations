<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit File</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-zinc-900 via-zinc-800 to-zinc-900 min-h-screen flex flex-col items-center p-6">

    <h1 class="text-5xl font-extrabold text-white tracking-wide mb-10 drop-shadow-lg">
        Edit File
    </h1>

    <!-- Form Container -->
    <div class="w-full max-w-xl bg-zinc-800/60 backdrop-blur-xl border border-zinc-700 p-10 rounded-2xl shadow-2xl">

        <form action="/edit" method="post" class="flex flex-col gap-6">

            <!-- Previous File Name -->
            <label class="text-gray-300 font-semibold text-sm tracking-wide">Previous File Name</label>
            <input
                class="px-4 py-3 rounded-lg bg-zinc-700 text-white placeholder-gray-400 shadow-inner outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                readonly type="text" name="previous" value="<%= filename %>">

            <!-- New File Name -->
            <label class="text-gray-300 font-semibold text-sm tracking-wide">Enter New File Name</label>
            <input
                class="px-4 py-3 rounded-lg bg-zinc-700 text-white placeholder-gray-400 shadow-inner outline-none focus:ring-2 focus:ring-green-500 transition-all"
                type="text" name="new" placeholder="Enter New File Name">

            <!-- File Type -->
            <label class="text-gray-300 font-semibold text-sm tracking-wide">File Type</label>
            <select name="fileType"
                class="px-4 py-3 rounded-lg bg-zinc-700 text-white shadow-inner outline-none focus:ring-2 focus:ring-purple-500 transition-all">
                <option value="">-- Select File Type --</option>
                <option value=".html">HTML</option>
                <option value=".css">CSS</option>
                <option value=".js">JS</option>
                <option value=".py">Python</option>
                <option value=".java">Java</option>
                <option value=".cpp">C++</option>
                <option value=".c">C</option>
                <option value=".json">JSON</option>
                <option value=".ts">TypeScript</option>
                <option value=".php">PHP</option>
                <option value=".rb">Ruby</option>
                <option value=".go">Go</option>
                <option value=".rs">Rust</option>
                <option value=".swift">Swift</option>
                <option value=".kt">Kotlin</option>
                <option value=".sql">SQL</option>
                <option value=".xml">XML</option>
                <option value=".yml">YAML</option>
                <option value=".md">Markdown</option>
                <option value=".txt">Text</option>
            </select>

            <!-- Submit Button -->
            <input
                class="mt-4 bg-gradient-to-r from-yellow-600 to-yellow-500 hover:from-yellow-500 hover:to-yellow-400 text-white font-bold py-3 rounded-xl shadow-xl cursor-pointer transform hover:scale-105 transition-all duration-150"
                type="submit" value="Update File Name">
        </form>
    </div>

</body>

</html>